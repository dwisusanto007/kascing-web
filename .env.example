# Environment variables for kascing-web
#
# The app currently runs entirely on local mock data (src/lib/mock-data.ts) —
# no environment variables are required to build or run it today.
#
# This file documents the variables you'll add once a real backend/API or
# third-party service is wired up, so they can be set consistently across
# Vercel's Production / Preview / Development environments
# (Project Settings -> Environment Variables).
#
# Uncomment and fill in when needed:

# Base URL of the backend API, once one exists.
# NEXT_PUBLIC_API_BASE_URL=https://api.kascing.id

# Any third-party service keys (analytics, email provider for the
# newsletter/registration forms, map provider for a real Direktori map, etc.)
# should be added here as <SERVICE>_API_KEY and documented in DEPLOYMENT.md.
